DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/job_apply_tool?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/job_apply_tool_test?schema=public"

# Existing runtime settings (optional examples)
GEMINI_API_KEY=""

# Hirist search. JOB_LOCATION accepts comma-separated cities (e.g. "Pune, Bangalore, Remote");
# see src/hirist/locations.ts. Leave it empty to search anywhere.
JOB_KEYWORD="Frontend Developer"
JOB_LOCATION="Pune"
# Optional experience filter in years, passed to Hirist search.
JOB_MIN_EXPERIENCE=""
JOB_MAX_EXPERIENCE=""
TARGET_DIRECT_JOBS="10"
MAX_JOBS_TO_INSPECT="60"
MAX_SEARCH_PAGES="5"
QUESTIONNAIRE_DRY_RUN="true"
APPLY_DRY_RUN="true"
BATCH_DRY_RUN="true"
BATCH_MAX_APPLICATIONS="3"
DAILY_MAX_READY_JOBS="10"
DAILY_RUN_STALE_MINUTES="180"
AUTO_APPLY_ENABLED="false"
AUTO_APPLY_DAILY_LIMIT="3"
AUTO_APPLY_RUN_LIMIT="3"

# Offerloop job agent (`npm run connect`): your Offerloop site and the key from
# Offerloop → Automations → Hirist agent → Connect your PC. See docs/offerloop-agent.md.
OFFERLOOP_URL=""
OFFERLOOP_AGENT_KEY=""
# Tailored resumes on Hirist (after `npm run resume:setup`): your own resume PDF, put back on
# your Hirist profile after each batch (else your Resume Studio resume is used); the file name
# recruiters see (default: your main resume's name); "off" to always apply with your profile resume.
OFFERLOOP_MAIN_RESUME=""
OFFERLOOP_RESUME_FILENAME=""
OFFERLOOP_TAILORED_RESUMES="on"
# Windows pop-ups when the agent applies or gets stuck. Set to "off" to turn them off.
OFFERLOOP_NOTIFY="on"
