# Copy to .env.local (never commit it).

# Accounts (Supabase Auth). Set both to turn on sign-up and log-in; leave empty for a
# one-person install. Supabase → Connect → App Frameworks → Next.js shows both.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Admins: comma-separated emails. No invite needed; they get the Admin page.
ADMIN_EMAILS=
# Optional invite codes that always work (comma-separated). Others: Admin page.
INVITE_CODES=
# "open" lets anyone sign up. Default: invite-only.
SIGNUP_MODE=
# Where users can reach you (shown in the privacy policy and terms).
SUPPORT_EMAIL=

# One-person install only: a site password. Leave empty on your own PC.
APP_PASSWORD=
# The public address, when behind a proxy/HTTPS (e.g. https://offerloop.example.com).
PUBLIC_URL=
# Save data in Postgres (e.g. Supabase's Session pooler string) instead of files in .data/.
DATABASE_URL=

# Resume Studio: optional server-side AI keys, used when a user hasn't added their own in
# AI settings. Leave empty to require each user's key.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Gmail → Tracker (read-only). Google Cloud Console → Credentials → OAuth client ID (Web).
# Redirect URI: http://localhost:3100/api/inbox/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the Gmail token cookie and stored secrets (CallMeBot keys). Any long random
# string, e.g. `openssl rand -hex 32`. Changing it signs everyone out of Gmail and makes
# saved Signal settings need re-entering.
INBOX_SECRET=
