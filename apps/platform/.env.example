# Copy to .env.local (never commit it).

# Resume Studio: optional server-side AI keys, used when a user hasn't added their own in
# AI settings. Leave empty to require each user's key.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Gmail → Tracker (read-only). Google Cloud Console → Credentials → OAuth client ID (Web).
# Redirect URI: http://localhost:3100/api/inbox/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the Gmail token cookie. Any long random string, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out of Gmail.
INBOX_SECRET=
