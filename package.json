{
  "name": "offerloop",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter @offerloop/platform dev",
    "dev:job-agent": "pnpm --filter @offerloop/job-agent dev",
    "build": "pnpm --filter @offerloop/platform build",
    "start": "pnpm --filter @offerloop/platform start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @offerloop/platform --filter @offerloop/resume-studio --filter @offerloop/storage test"
  }
}
