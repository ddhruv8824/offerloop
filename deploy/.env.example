# Copy to deploy/.env on the server and fill in. Never commit .env.

# The address the site lives at, without https://. Free option without buying a domain:
# your server's public IP with dashes + .sslip.io, e.g. 140-238-1-23.sslip.io
DOMAIN=
# The same, with https:// — used for redirects and the Gmail sign-in callback.
PUBLIC_URL=

# Site password: everyone must enter it once per browser. Use a long one.
APP_PASSWORD=

# Encrypts the Gmail login cookie. Make one with: openssl rand -hex 32
INBOX_SECRET=

# Optional: Gmail → Tracker (see README). Add https://DOMAIN/api/inbox/google/callback
# as a redirect URI in Google Cloud Console first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: server AI keys for Resume Studio, used when the browser has no key of its own.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
